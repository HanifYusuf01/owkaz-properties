DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=owkaz

JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# Email (use Mailtrap for dev: https://mailtrap.io)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your-mailtrap-user
MAIL_PASS=your-mailtrap-pass
MAIL_FROM=noreply@owkaz.com

FRONTEND_URL=http://localhost:5173

PORT=3000

# Google Sign-In (Google Identity Services OAuth Client ID — see setup notes)
GOOGLE_CLIENT_ID=

# AI auto-reply for the inquiry chat — GROQ_API_KEY is checked first and is genuinely free,
# no card required (get one at https://console.groq.com/keys). ANTHROPIC_API_KEY is an optional
# paid alternative if you already have one — only used when GROQ_API_KEY is blank.
# Leave both blank to disable — the chat still works normally, just without AI-drafted replies.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
